{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "mux.min.js",
      "offscreen.js",
      "firefox-bridge.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "videograb@siflie.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "all_frames": true,
      "exclude_matches": [
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hbo.com/*",
        "*://*.max.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "all_frames": true,
      "exclude_matches": [
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hbo.com/*",
        "*://*.max.com/*"
      ],
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "description": "Detect and download videos playing in your browser (X/Twitter, Douyin, Bilibili, YouTube, direct MP4/WebM and HLS streams).",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "VideoGrab — Free Video Downloader",
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "activeTab",
    "webRequest",
    "declarativeNetRequest"
  ],
  "version": "0.1.3"
}